{
  "name": "@velella/lateen",
  "version": "0.2.1",
  "description": "A docs theme for people and agents, built on Mizzen.",
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "static-site",
    "agents",
    "velella",
    "theme",
    "rtl",
    "accessibility",
    "wcag"
  ],
  "homepage": "https://velella.sh/lateen/",
  "bugs": {
    "url": "https://github.com/velella-sh/lateen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/lateen.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "tokens:check": "node scripts/tokens.ts --check",
    "test": "node scripts/tokens.ts --check && node --test \"test/**/*.test.ts\"",
    "test:a11y": "node scripts/test-a11y.ts",
    "test:performance": "node scripts/performance-budget.ts",
    "test:coverage": "node scripts/tokens.ts --check && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "coverage:badge": "node scripts/coverage-badge.ts coverage/lcov.info coverage/coverage.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@velella/mizzen": "0.2.0",
    "jsdom": "^31.0.0",
    "mermaid": "^12.3.0",
    "shiki": "^4.6.0"
  },
  "peerDependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "playwright": "1.65.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "layouts",
    "chrome",
    "components",
    "styles",
    "tokens",
    "fonts",
    "i18n",
    "icons",
    "skills",
    "!skills/*-workspace",
    "!skills/**/evals",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
